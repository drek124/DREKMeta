<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_DREKMETA_FILTER_SEARCH_LABEL"
			description="COM_DREKMETA_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="state"
			type="list"
			label="JSTATUS"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field
			name="menutype"
			type="menu"
			label="COM_DREKMETA_FILTER_MENU_LABEL"
			clientid="0"
			onchange="this.form.submit();"
			>
			<option value="">COM_DREKMETA_FILTER_MENU_SELECT</option>
		</field>
		<field
			name="embed"
			type="list"
			label="COM_DREKMETA_FILTER_EMBED_LABEL"
			onchange="this.form.submit();"
			>
			<option value="">COM_DREKMETA_FILTER_EMBED_SELECT</option>
			<option value="1">COM_DREKMETA_EMBED_ON</option>
			<option value="0">COM_DREKMETA_EMBED_OFF</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			default="a.title ASC"
			onchange="this.form.submit();"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="m.title ASC">COM_DREKMETA_SORT_MENU_ITEM_ASC</option>
			<option value="m.title DESC">COM_DREKMETA_SORT_MENU_ITEM_DESC</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.component_embed_enabled ASC">COM_DREKMETA_SORT_EMBED_ASC</option>
			<option value="a.component_embed_enabled DESC">COM_DREKMETA_SORT_EMBED_DESC</option>
			<option value="a.modified ASC">COM_DREKMETA_SORT_MODIFIED_ASC</option>
			<option value="a.modified DESC">COM_DREKMETA_SORT_MODIFIED_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
