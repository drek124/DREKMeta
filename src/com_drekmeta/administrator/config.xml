<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="output" label="COM_DREKMETA_CONFIG_OUTPUT_LABEL" description="COM_DREKMETA_CONFIG_OUTPUT_DESC">
		<field
			name="remove_existing_og"
			type="radio"
			label="COM_DREKMETA_CONFIG_REMOVE_EXISTING_OG_LABEL"
			description="COM_DREKMETA_CONFIG_REMOVE_EXISTING_OG_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
